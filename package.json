{
  "name": "lumo",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "npm run dev -w @lumo/backend",
    "build": "npm run build -w @lumo/backend",
    "start": "npm run start -w @lumo/backend",
    "test": "npm run test -w @lumo/backend",
    "db:generate": "npm run db:generate -w @lumo/backend",
    "db:migrate": "npm run db:migrate -w @lumo/backend",
    "db:deploy": "npm run db:deploy -w @lumo/backend",
    "db:validate": "npm run db:validate -w @lumo/backend",
    "db:smoke": "npm run db:smoke -w @lumo/backend"
  }
}
