{
  "name": "lumo",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm run dev -w @lumo/frontend",
    "dev:backend": "npm run dev -w @lumo/backend",
    "build": "npm run build --workspaces --if-present",
    "build:frontend": "npm run build -w @lumo/frontend",
    "preview": "npm run preview -w @lumo/frontend",
    "start": "npm run start -w @lumo/backend",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @lumo/backend",
    "db:migrate": "npm run db:migrate -w @lumo/backend --",
    "db:deploy": "npm run db:deploy -w @lumo/backend",
    "db:validate": "npm run db:validate -w @lumo/backend",
    "db:smoke": "npm run db:smoke -w @lumo/backend"
  }
}
